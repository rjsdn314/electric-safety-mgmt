# ============================================================
# .env.example — 환경변수 예시
# 이 파일을 복사해서 .env.local로 저장 후 실제 값 입력
# ============================================================

# Supabase 설정 (Supabase 대시보드 → Settings → API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (서버 전용, 절대 공개 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic API 키 (서버 전용) — 별지7 열화상 사진 부위(PF/PT/CH) AI 자동 분류
# 없으면 사진 온도 자동 기입은 되고, 부위만 화면에서 직접 지정
ANTHROPIC_API_KEY=

# 앱 URL (Vercel 배포 후 변경)
NEXT_PUBLIC_APP_URL=http://localhost:3000
